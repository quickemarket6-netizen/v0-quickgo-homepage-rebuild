# ── Supabase ──────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Wallet security ───────────────────────────────────────────
# Server-side pepper mixed into wallet PIN hashes. A leaked DB hash can't be
# brute-forced without this secret. Generate: openssl rand -hex 32
WALLET_PIN_PEPPER=

# ── Rate limiting — Upstash Redis ────────────────────────────
# https://console.upstash.com → Create Database → REST API → copy credentials
# Without these, rate limiting falls back to in-memory (dev only — not safe in prod).
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXxx...

# ── Email — Resend ────────────────────────────────────────────
# https://resend.com → API Keys
RESEND_API_KEY=re_...
# Domain must be verified in Resend (MX/DKIM records on quickgo.cm)

# ── SMS — Africa's Talking ────────────────────────────────────
# https://africastalking.com → Settings → API Key
# Use username=sandbox + any key for local testing (hits sandbox API)
AFRICASTALKING_API_KEY=atsk_...
AFRICASTALKING_USERNAME=quickgo          # sandbox | your AT username
SMS_SENDER_ID=QuickGo                    # max 11 chars, must be registered with AT

# ── WhatsApp Business API (Meta) ──────────────────────────────
# https://developers.facebook.com → WhatsApp → API Setup
WHATSAPP_ACCESS_TOKEN=EAAxxxxx...
WHATSAPP_PHONE_NUMBER_ID=1234567890      # From Meta Business → WhatsApp Business Account

# ── Payments — CinetPay ──────────────────────────────────────
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_SECRET_KEY=
NEXT_PUBLIC_APP_URL=https://quickgo237.com  # Canonical domain (no trailing slash, no www)

# ── AI ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# Sakana Fugu — OpenAI-compatible multi-agent model (https://console.sakana.ai)
# Used by the QuickGo AI assistant (default model). Key starts with "fish_".
SAKANA_API_KEY=fish_...
# Optional override; defaults to https://api.sakana.ai/v1
SAKANA_BASE_URL=https://api.sakana.ai/v1

# ── Push Notifications (Web Push / VAPID) ────────────────────
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
